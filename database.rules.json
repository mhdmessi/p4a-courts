{
  "rules": {
    ".read": false,
    ".write": false,
    "p4a": {
      ".read": true,
      "players": {
        "$pid": {
          ".write": "auth != null && root.child('p4a/meta/admins').child(auth.uid).exists()",
          "name": {
            ".write": "!data.exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 60"
          },
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
          },
          "dupr": {
            ".validate": "newData.isString() && newData.val().length < 20"
          }
        }
      },
      "sessions": {
        "$sid": {
          ".write": "!data.exists() || newData.exists()",
          ".validate": "newData.child('date').isString()"
        }
      },
      "meta": {
        "settings": {
          ".write": true
        },
        "admins": {
          ".write": "auth != null && (!data.exists() || data.child(auth.uid).exists())"
        },
        "history": {
          ".write": "auth != null && root.child('p4a/meta/admins').child(auth.uid).exists()"
        },
        "ratingsSync": {
          ".write": "auth != null && root.child('p4a/meta/admins').child(auth.uid).exists()"
        }
      },
      "practice": {
        ".write": true
      }
    }
  }
}